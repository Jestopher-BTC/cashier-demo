# Copy this to .env and fill in the blanks:
#   cp .env.example .env && chmod 600 .env && nano .env
#
# Every value here has a working default except the three marked REQUIRED.
# Full explanation of each knob lives in server/config.js.

# --- server -------------------------------------------------------------
PORT=8080

# Set to 1 to run against the local fake Amboss client instead of the real
# API — no key needed, nothing settles for real. Leave unset (or 0) for a
# real deploy.
MOCK_AMBOSS=0

# --- Amboss API -----------------------------------------------------------
# https://app.amboss.tech/graphql for both sandbox and live; only the key
# and wallet id below determine which environment you're actually hitting.
AMBOSS_GRAPHQL_URL=https://app.amboss.tech/graphql

# REQUIRED. Mint this at app.amboss.tech/pay: a service API key scoped to
# the wallet id below, with PAYMENTS: WRITE and WALLETS: READ. Do NOT grant
# WALLET_CREDENTIALS — see DEPLOY.md section 2 for why. The plaintext key is
# shown once when you create it.
AMBOSS_API_KEY=

# REQUIRED. The wallet id the key above is scoped to.
AMBOSS_WALLET_ID=

# BTC, USDT, or USDC. Must match the asset of the wallet above. See
# DEPLOY.md section 1 for the tradeoffs between a BTC wallet (sats hint
# shown under the deposit QR) and a stablecoin wallet (balance is really
# dollars on-chain, pending the address-payout probe).
AMBOSS_ASSET=BTC

# Whether cashtag/Lightning-address withdrawals are attempted. Leave true;
# the server detects a real "unsupported" rejection at runtime and falls
# back to invoice-only automatically for the rest of the day. Only set this
# to false to force invoice-only from the start (e.g. you already know the
# wallet's asset doesn't support it).
ADDRESS_PAYOUTS=true

# --- BTC/USD rate -----------------------------------------------------------
# Used for /healthz and for pricing BOLT11 invoice cash-outs, even when the
# wallet settles in USDT/USDC (invoices are always sat-denominated). Cashtag
# and Lightning-address payouts stay in dollars and do not use this rate.
# "live" fetches Coinbase, then CoinGecko. "static" is for offline tests only.
RATE_SOURCE=live
USD_PER_BTC=100000

# --- caps, in dollars -------------------------------------------------------
MIN_DEPOSIT_USD=1
MAX_DEPOSIT_USD=5
MIN_WITHDRAW_USD=1
MAX_WITHDRAW_USD=5

# --- the Fund button --------------------------------------------------------
# Free balance granted to a visitor when the operator taps Fund, gated by
# the PIN below. Leave OPERATOR_PIN blank to disable funding entirely.
SESSION_START_USD=2
DAILY_FLOAT_USD=25
OPERATOR_PIN=

# --- misc -------------------------------------------------------------------
# How long a deposit invoice stays open before it expires.
INVOICE_SECONDS=180
