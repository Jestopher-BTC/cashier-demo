# Copy this to .env and fill in the blanks:
#   cp .env.example .env && chmod 600 .env && nano .env
#
# Every value here has a working default except the three marked REQUIRED.
# Full explanation of each knob lives in server/config.js.

# --- server -------------------------------------------------------------
PORT=8080

# Set to 1 to run against the local fake Amboss client instead of the real
# API — no key needed, nothing settles for real. Leave unset (or 0) for a
# real deploy.
MOCK_AMBOSS=0

# --- Amboss API -----------------------------------------------------------
# https://app.amboss.tech/graphql for both sandbox and live; only the key
# and wallet id below determine which environment you're actually hitting.
AMBOSS_GRAPHQL_URL=https://app.amboss.tech/graphql

# REQUIRED. Mint this at app.amboss.tech/pay: a service API key scoped to
# the wallet id below, with PAYMENTS: WRITE, WALLETS: READ, and
# WALLET_CREDENTIALS: READ. Live payouts use the official Payments SDK send
# path, which decrypts the node macaroon. The plaintext key is shown once.
AMBOSS_API_KEY=

# REQUIRED. The wallet id the key above is scoped to.
AMBOSS_WALLET_ID=

# REQUIRED for live payouts (amb_live_ keys). The team password from the
# Amboss Payments / Rails account. The SDK uses it in-process to decrypt
# wallet credentials; the raw password is never sent to the API.
# TEAM_PASSWORD is accepted as an alias.
AMBOSS_TEAM_PASSWORD=

# Optional. Argon2 salt override. Leave blank; the SDK reads team_id from
# the wallet.
AMBOSS_TEAM_ID=

# BTC, USDT, or USDC. Must match the asset of the wallet above. See
# DEPLOY.md section 1 for the tradeoffs between a BTC wallet (sats hint
# shown under the deposit QR) and a stablecoin wallet (balance is really
# dollars on-chain, pending the address-payout probe).
AMBOSS_ASSET=BTC

# Whether cashtag/Lightning-address withdrawals are attempted. Leave true;
# the server detects a real "unsupported" rejection at runtime and falls
# back to invoice-only automatically for the rest of the day. Only set this
# to false to force invoice-only from the start (e.g. you already know the
# wallet's asset doesn't support it).
ADDRESS_PAYOUTS=true

# --- BTC/USD rate -----------------------------------------------------------
# Used for /healthz, BOLT11 invoice cash-outs, and the sats figure on
# cashtag / Lightning-address sends (LNURL is sat-denominated). The player's
# USDT/USDC dollar amount is never multiplied by this rate.
# "live" fetches Coinbase, then CoinGecko. "static" is for offline tests only.
RATE_SOURCE=live
USD_PER_BTC=100000

# --- caps, in dollars -------------------------------------------------------
MIN_DEPOSIT_USD=1
MAX_DEPOSIT_USD=5
MIN_WITHDRAW_USD=1
MAX_WITHDRAW_USD=5

# --- the Fund button --------------------------------------------------------
# Fund is on ONLY when both of these are true:
#   1) FUND_ENABLED is on (default true if unset or blank)
#   2) OPERATOR_PIN is a non-empty PIN
#
# Disable Fund (button grayed out, not clickable, server refuses grants):
#   FUND_ENABLED=false     explicit kill switch. Also accepts 0 or no.
#                          Works even if OPERATOR_PIN is still set.
#   OPERATOR_PIN=          blank or missing PIN also disables Fund.
#                          Empty PIN is not "unlocked" / skip-the-prompt.
#
# When Fund is on, every Fund click asks for OPERATOR_PIN. No session unlock.
SESSION_START_USD=2
DAILY_FLOAT_USD=25
FUND_ENABLED=true
OPERATOR_PIN=

# --- misc -------------------------------------------------------------------
# How long a deposit invoice stays open before it expires.
INVOICE_SECONDS=180
